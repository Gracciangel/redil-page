# Copiar a .env en la raíz del repo. Nunca commitear el archivo con valores reales.
# Vite lo carga desde spa/ gracias a envDir: '..' en spa/vite.config.ts.

VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key pública, nunca service_role>

# Tabla pública usada como fallback si la RPC no está desplegada.
VITE_SUPABASE_STATS_TABLE=metrics_redil

# RPC pública que devuelve la última fila de métricas.
VITE_SUPABASE_METRICS_RPC=get_redil_metrics

# Opcional: endpoint HTTP alternativo (solo si no se usa Supabase).
# VITE_API_URL=https://tu-api.example.com
# VITE_LANDING_STATS_URL=https://tu-api.example.com/public/stats
